# Copy to .env and set your own API key. Never commit .env.
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
# Optional; enable only for a model that supports reasoning_effort.
# LLM_REASONING_EFFORT=medium

# Alembic only: set the path to the local D1 SQLite file created by Wrangler.
# DATABASE_URL=sqlite:///.wrangler/state/v3/d1/miniflare-D1DatabaseObject/<database-id>.sqlite

# Form review confidence and session TTL (seconds or ISO 8601 duration).
CONFIDENCE_THRESHOLD=75
SESSION_TTL=86400

# Maximum uploaded JPEG size in bytes (20 MiB).
MAX_UPLOAD_SIZE_BYTES=20971520
